-- --- АРЕНАДА ЕКЕНІН ТЕКСЕРУ (Шөпті/Grass және сыртты өткізбейді) ---
local function isInArena(character)
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	local root = character.HumanoidRootPart
	
	-- 1. Табан астындағы материалды тексеру (Raycast)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {character}
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -10, 0), raycastParams)
	if rayResult then
		-- Егер табанында ШӨП (Grass) болса, ол аренаның сыртында
		if rayResult.Material == Enum.Material.Grass then
			return false
		end
	end

	return true
end

